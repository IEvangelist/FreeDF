<Project>
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.5</VersionSuffix>
    <Authors>David Pine</Authors>
    <Company>IEvangelist</Company>
    <Copyright>Copyright (c) 2026-Present David Pine</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://ievangelist.github.io/FreeDF/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/IEvangelist/FreeDF</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Release notes and known limitations: https://github.com/IEvangelist/FreeDF/releases</PackageReleaseNotes>
    <PackageTags>pdf;pdf-2.0;document;rendering;text-extraction</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)docs\nuget-readme.md" Pack="true" PackagePath="\README.md" />
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)tests\fixtures\ucd\UNICODE-LICENSE.txt" Pack="true" PackagePath="licenses\UNICODE-LICENSE.txt" />
  </ItemGroup>
</Project>
