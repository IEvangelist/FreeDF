<Project>
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>
    <Authors>David Pine</Authors>
    <Company>IEvangelist</Company>
    <Copyright>Copyright (c) 2026-Present David Pine</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/IEvangelist/FreeDF</PackageProjectUrl>
    <RepositoryUrl>https://github.com/IEvangelist/FreeDF</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>pdf;pdf-2.0;document</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)tests\fixtures\ucd\UNICODE-LICENSE.txt" Pack="true" PackagePath="licenses\" />
  </ItemGroup>
</Project>
