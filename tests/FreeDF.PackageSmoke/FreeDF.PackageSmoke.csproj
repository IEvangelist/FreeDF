<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PortableDocument.Render" Version="$(Version)" />
    <PackageReference Include="PortableDocument.FallbackFonts" Version="$(Version)" />
    <PackageReference Include="PortableDocument.Signing.Http" Version="$(Version)" />
  </ItemGroup>
</Project>
