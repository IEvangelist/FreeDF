<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PortableDocument.Render\PortableDocument.Render.csproj" />
    <ProjectReference Include="..\..\src\PortableDocument.Signing.Http\PortableDocument.Signing.Http.csproj" />
    <ProjectReference Include="..\..\src\PortableDocument.FallbackFonts\PortableDocument.FallbackFonts.csproj" />
    <ProjectReference Include="..\..\tools\AdoBye.Samples\AdoBye.Samples.csproj" />
    <ProjectReference Include="..\..\tools\AdoBye.EditorWeb\AdoBye.EditorWeb.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\tools\AdoBye.EditorWeb\FontCatalog.cs" Link="EditorWeb\FontCatalog.cs" />
    <Compile Include="..\..\tools\AdoBye.EditorWeb\OverlayBuilder.cs" Link="EditorWeb\OverlayBuilder.cs" />
    <Compile Include="..\..\tools\AdoBye.EditorWeb\FormObjectEditPolicy.cs" Link="EditorWeb\FormObjectEditPolicy.cs" />
    <Compile Include="..\..\tools\AdoBye.EditorWeb\EditorSession.cs" Link="EditorWeb\EditorSession.cs" />
    <Compile Include="..\..\tools\AdoBye.EditorWeb\EditorForms.cs" Link="EditorWeb\EditorForms.cs" />
    <Compile Include="..\..\tools\AdoBye.EditorSmoke\MergeErrorClassifier.cs" Link="EditorSmoke\MergeErrorClassifier.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\samples\*.pdf" Link="fixtures\samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\fixtures\**\*" Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>