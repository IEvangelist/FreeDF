<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>PortableDocument.Core</PackageId>
    <Description>PDF object model, parser, file structure, filters, encryption, and signature primitives.</Description>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PortableDocument.Content" />
    <InternalsVisibleTo Include="PortableDocument.Document" />
    <InternalsVisibleTo Include="FreeDF.Tests" />
    <EmbeddedResource Include="Resources\glyphlist.txt" LogicalName="PortableDocument.Core.Resources.glyphlist.txt" />
    <EmbeddedResource Include="Resources\zapfdingbats.txt" LogicalName="PortableDocument.Core.Resources.zapfdingbats.txt" />
    <PackageReference Include="GregsEx" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

</Project>
